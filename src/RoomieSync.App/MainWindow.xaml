<Window x:Class="RoomieSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RoomieSync.App.ViewModels"
        xmlns:svc="clr-namespace:RoomieSync.App.Services"
        Title="RoomieSync"
        Width="1320" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        
        <ContentControl Content="{Binding Navigator.CurrentScreen}" Focusable="False" />

        
        <Grid Visibility="{Binding Dialogs.CurrentDialog, Converter={StaticResource EmptyToCollapsed}}">
            <Border Background="{StaticResource OverlayBrush}" />
            <Border Style="{StaticResource Card}" Padding="26,22" Width="{Binding Dialogs.CurrentDialog.Width}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource PopupShadow}" MaxHeight="760">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Dialogs.CurrentDialog.Title}" Style="{StaticResource CardTitle}" FontSize="17" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="32" Height="32" Content="&#xE711;" FontSize="11"
                                HorizontalAlignment="Right" Command="{Binding Dialogs.CurrentDialog.CancelCommand}"
                                ToolTip="{DynamicResource S.Common.Close}" />
                    </Grid>
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Banner}" Margin="0,14,0,0"
                            Visibility="{Binding Dialogs.CurrentDialog.Error, Converter={StaticResource EmptyToCollapsed}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Dialogs.CurrentDialog.Error}" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" FontSize="12" MaxWidth="380" />
                        </StackPanel>
                    </Border>
                    <ContentControl Content="{Binding Dialogs.CurrentDialog}" Focusable="False" />
                </DockPanel>
            </Border>
        </Grid>

        
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" CornerRadius="12" Padding="16,12"
                Background="{StaticResource TextPrimaryBrush}" Effect="{StaticResource PopupShadow}" MaxWidth="420"
                Visibility="{Binding Toast.Current, Converter={StaticResource EmptyToCollapsed}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Toast.Current.Kind}" Value="{x:Static svc:ToastKind.Error}">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Toast.Current.Kind}" Value="{x:Static svc:ToastKind.Info}">
                                    <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="White" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Setter Property="Text" Value="&#xE73E;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toast.Current.Kind}" Value="{x:Static svc:ToastKind.Error}">
                                        <Setter Property="Text" Value="&#xE711;" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Toast.Current.Kind}" Value="{x:Static svc:ToastKind.Info}">
                                        <Setter Property="Text" Value="&#xE946;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock Text="{Binding Toast.Current.Text}" Foreground="White" FontFamily="{StaticResource AppFont}" FontSize="12.5"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="340" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
