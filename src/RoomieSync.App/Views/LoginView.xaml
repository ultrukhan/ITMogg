<UserControl x:Class="RoomieSync.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:RoomieSync.App.Helpers">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        
        <Grid Background="{StaticResource LoginHeroBrush}" ClipToBounds="True">
            <Ellipse Width="520" Height="520" Fill="#22FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-140,0,0" />
            <Ellipse Width="380" Height="380" Fill="#18FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-90" />
            <StackPanel Orientation="Horizontal" Margin="32,28" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Border Width="38" Height="38" CornerRadius="10" Background="White">
                    <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" />
                </Border>
                <TextBlock Text="{DynamicResource S.App.Name}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontFamily="{StaticResource AppFont}" />
            </StackPanel>

            
            <Viewbox Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
                <Grid Width="300" Height="260">
                    <Border Width="220" Height="150" CornerRadius="18" Background="#F2FFFFFF" VerticalAlignment="Bottom" />
                    <Path Data="M 40,118 L 150,24 L 260,118 Z" Fill="White" Opacity="0.95" />
                    <Border Width="58" Height="78" CornerRadius="10,10,0,0" Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                    <Border Width="44" Height="38" CornerRadius="8" Background="#FFE9D8" VerticalAlignment="Bottom"
                            HorizontalAlignment="Left" Margin="62,0,0,62" />
                    <Border Width="44" Height="38" CornerRadius="8" Background="#FFE9D8" VerticalAlignment="Bottom"
                            HorizontalAlignment="Right" Margin="0,0,62,62" />
                    <Ellipse Width="16" Height="16" Fill="#F5B82E" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,70,0,0" />
                </Grid>
            </Viewbox>

            <StackPanel VerticalAlignment="Bottom" Margin="32,0,32,36">
                <TextBlock Text="{DynamicResource S.Login.HeroTitle}" Foreground="White" FontSize="24" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource S.Login.HeroText}" Foreground="#F2FFFFFF" FontSize="13" Margin="0,8,0,0"
                           FontFamily="{StaticResource AppFont}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>

        
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="360" VerticalAlignment="Center" Margin="0,40">
                <TextBlock Text="{DynamicResource S.Login.Title}" Style="{StaticResource PageTitle}" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource S.Login.Subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,28" />

                <TextBlock Text="{DynamicResource S.Login.Email}" Style="{StaticResource Label}" />
                <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE715;" h:Input.Placeholder="{DynamicResource S.Login.EmailPlaceholder}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{DynamicResource S.Login.Password}" Style="{StaticResource Label}" Margin="0,18,0,7" />
                <Grid>
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPassword}" h:Input.Icon="&#xE72E;"
                                 h:Input.Placeholder="{DynamicResource S.Login.PasswordPlaceholder}"
                                 h:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE72E;"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Background="Transparent" Width="30" Height="30" HorizontalAlignment="Right"
                            Margin="0,0,6,0" Content="&#xE7B3;" Command="{Binding TogglePasswordVisibilityCommand}"
                            ToolTip="{DynamicResource S.Login.ShowPassword}" />
                </Grid>

                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Margin="0,10,0,0" FontSize="11.5"
                        Content="{DynamicResource S.Login.Forgot}" Command="{Binding ForgotPasswordCommand}" />

                <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Height="44" IsDefault="True"
                        Content="{DynamicResource S.Login.SignIn}" Command="{Binding SignInCommand}" />

                
                <Border Style="{StaticResource Banner}" Margin="0,16,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" MaxWidth="290" />
                    </StackPanel>
                </Border>

                
                <Border Style="{StaticResource Banner}" Margin="0,16,0,0" Visibility="{Binding IsLockedOut, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding LockoutMessage}" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" MaxWidth="290" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <TextBlock Text="{DynamicResource S.Login.NoAccount}" Style="{StaticResource Muted}" Margin="0,0,5,0" />
                    <Button Style="{StaticResource LinkButton}" Content="{DynamicResource S.Login.CreateHousehold}" Command="{Binding CreateHouseholdCommand}" />
                </StackPanel>

                
                <Border Margin="0,28,0,0" CornerRadius="10" Padding="14,10" Background="{StaticResource PrimaryLightBrush}"
                        Visibility="{Binding ShowDemoHint, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Login.DemoTitle}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0">
                                <Run Text="{Binding DemoEmail, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding DemoPassword, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Content="{DynamicResource S.Login.DemoFill}"
                                Command="{Binding FillDemoCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
