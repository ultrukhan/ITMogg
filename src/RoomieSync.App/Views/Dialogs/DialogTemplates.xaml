<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:RoomieSync.App.Controls"
                    xmlns:h="clr-namespace:RoomieSync.App.Helpers"
                    xmlns:d="clr-namespace:RoomieSync.App.ViewModels.Dialogs">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    
    <DataTemplate DataType="{x:Type d:ConfirmDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{Binding Message}" Style="{StaticResource BaseText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="None" LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVis}}" IsCancel="True" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="Effect" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    
    <DataTemplate DataType="{x:Type d:ChoreEditorDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{DynamicResource S.Chores.TaskName}" Style="{StaticResource Label}" />
            <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE9D5;" h:Input.Placeholder="{DynamicResource S.Chores.TaskPlaceholder}"
                     Text="{Binding ChoreTitle, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{DynamicResource S.Chores.AssignedTo}" Style="{StaticResource Label}" Margin="0,14,0,7" />
            <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Assignees}" SelectedItem="{Binding SelectedAssignee}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Chores.Deadline}" Style="{StaticResource Label}" />
                    <DatePicker Style="{StaticResource AppDatePicker}" SelectedDate="{Binding DeadlineDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource S.Chores.Time}" Style="{StaticResource Label}" />
                    <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE823;" h:Input.Placeholder="18:00"
                             Text="{Binding DeadlineTime, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Chores.Rotation}" Style="{StaticResource Label}" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Rotations}" SelectedItem="{Binding SelectedRotation}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{DynamicResource S.Chores.Status}" Style="{StaticResource Label}" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource S.Chores.RotationHint}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />

            <Grid Margin="0,22,0,0">
                <Button Style="{StaticResource DangerOutlineButton}" HorizontalAlignment="Left" Content="{DynamicResource S.Common.Delete}"
                        Command="{Binding DeleteCommand}" Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Common.Save}" Command="{Binding ConfirmCommand}" IsDefault="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    
    <DataTemplate DataType="{x:Type d:AssigneeDialogViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap">
                <Run Text="{DynamicResource S.Chores.WhoShouldDo}" /> <Run Text="{Binding ChoreTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" /><Run Text="?" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,2"
                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <c:Avatar Size="32" Initials="{Binding Initials}" ColorHex="{Binding AvatarColor}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BaseText}" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    
    <DataTemplate DataType="{x:Type d:MemberEditDialogViewModel}">
        <StackPanel>
            <TextBlock Text="{DynamicResource S.Settings.Name}" Style="{StaticResource Label}" />
            <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE77B;" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <Border Style="{StaticResource Divider}" Margin="0,18" />
            <TextBlock Text="{DynamicResource S.Settings.LoginTitle}" Style="{StaticResource Label}" Margin="0,0,0,2" />
            <TextBlock Text="{DynamicResource S.Settings.LoginHint}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE715;" h:Input.Placeholder="{DynamicResource S.Login.EmailPlaceholder}"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox Style="{StaticResource InputPassword}" Margin="0,8,0,0" h:Input.Icon="&#xE72E;" h:Input.Placeholder="{DynamicResource S.Settings.NewPassword}"
                         h:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Common.Save}" Command="{Binding ConfirmCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    
    <DataTemplate DataType="{x:Type d:ExpenseDetailsDialogViewModel}">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Background="{Binding Row.CategoryLightBrush}">
                    <TextBlock Text="{Binding Row.Glyph}" Style="{StaticResource Icon}" Foreground="{Binding Row.CategoryBrush}" FontSize="17" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Row.Title}" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding Row.DateText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding Row.CategoryName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Expenses.ColTotal}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Row.Amount, Converter={StaticResource Money}}" Style="{StaticResource BigNumber}" FontSize="24" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource S.Expenses.ColPaidBy}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <c:Avatar Size="26" Initials="{Binding Row.Payer.Initials}" ColorHex="{Binding Row.Payer.AvatarColor}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Row.Payer.DisplayName}" Style="{StaticResource BaseText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Divider}" Margin="0,16" />
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource S.Expenses.SplitBetween}" Style="{StaticResource Label}" Margin="0" />
                <TextBlock Text="{Binding SplitMethodText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Shares}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <StackPanel Orientation="Horizontal">
                                <c:Avatar Size="28" Initials="{Binding Member.Initials}" ColorHex="{Binding Member.AvatarColor}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PercentText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource BaseText}" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="{Binding Row.Expense.ReceiptImagePath, Converter={StaticResource EmptyToCollapsed}}">
                <Run Text="&#xE722;" FontFamily="{StaticResource IconFont}" /> <Run Text="{DynamicResource S.Expenses.HasReceipt}" />
            </TextBlock>

            <Grid Margin="0,22,0,0">
                <Button Style="{StaticResource DangerOutlineButton}" HorizontalAlignment="Left" Content="{DynamicResource S.Common.Delete}" Command="{Binding DeleteCommand}" />
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Content="{DynamicResource S.Common.Close}" Command="{Binding CancelCommand}" IsDefault="True" />
            </Grid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
