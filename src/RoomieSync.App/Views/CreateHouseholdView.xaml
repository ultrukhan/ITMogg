<UserControl x:Class="RoomieSync.App.Views.CreateHouseholdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:RoomieSync.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="440" Margin="0,40" Padding="30,28" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18">
            <StackPanel>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="8,4" Margin="-8,-8,0,0"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource S.Setup.BackToLogin}" FontSize="12" />
                    </StackPanel>
                </Button>

                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                        Effect="{StaticResource ButtonShadow}">
                    <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Foreground="White" FontSize="20" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Border Width="16" Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Setup.Step}" Style="{StaticResource Caption}" FontSize="10" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{DynamicResource S.Setup.Title}" Style="{StaticResource PageTitle}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource S.Setup.Subtitle}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,22" />

                <TextBlock Text="{DynamicResource S.Setup.HouseholdName}" Style="{StaticResource Label}" />
                <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE80F;" h:Input.Placeholder="{DynamicResource S.Setup.HouseholdPlaceholder}"
                         Text="{Binding HouseholdName, UpdateSourceTrigger=PropertyChanged}" />

                <Border Style="{StaticResource Divider}" Margin="0,22" />

                
                <TextBlock Text="{DynamicResource S.Setup.YourAccount}" Style="{StaticResource Label}" Margin="0,0,0,2" />
                <TextBlock Text="{DynamicResource S.Setup.YourAccountHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
                <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE77B;" h:Input.Placeholder="{DynamicResource S.Setup.YourName}"
                         Text="{Binding AdminName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Style="{StaticResource InputBox}" Margin="0,8,0,0" h:Input.Icon="&#xE715;" h:Input.Placeholder="{DynamicResource S.Login.EmailPlaceholder}"
                         Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" />
                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <PasswordBox Style="{StaticResource InputPassword}" Margin="0,0,4,0" h:Input.Icon="&#xE72E;"
                                 h:Input.Placeholder="{DynamicResource S.Setup.Password}"
                                 h:PasswordBoxHelper.BoundPassword="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                    <PasswordBox Style="{StaticResource InputPassword}" Margin="4,0,0,0" h:Input.Icon="&#xE72E;"
                                 h:Input.Placeholder="{DynamicResource S.Setup.ConfirmPassword}"
                                 h:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />
                </UniformGrid>

                <Border Style="{StaticResource Divider}" Margin="0,22" />

                <TextBlock Text="{DynamicResource S.Setup.AddMembers}" Style="{StaticResource Label}" Margin="0,0,0,2" />
                <TextBlock Text="{DynamicResource S.Setup.AddMembersHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE77B;" h:Input.Placeholder="{DynamicResource S.Setup.MemberName}"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="40" Height="40" Margin="8,0,0,0" Content="&#xE74D;"
                                        ToolTip="{DynamicResource S.Common.Remove}"
                                        Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Command="{Binding AddMemberCommand}" Cursor="Hand" Margin="0,2,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Height="40" CornerRadius="9" BorderThickness="1" BorderBrush="#F5C4A6" Background="Transparent">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource S.Setup.AddAnother}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"
                                               FontFamily="{StaticResource AppFont}" FontSize="12.5" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Style="{StaticResource Banner}" Margin="0,16,0,0" Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Height="46" Margin="0,20,0,0" FontSize="14"
                        Content="{DynamicResource S.Setup.Complete}" Command="{Binding CompleteSetupCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
