<UserControl x:Class="RoomieSync.App.Views.Pages.AddExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="clr-namespace:RoomieSync.App.Helpers"
             xmlns:c="clr-namespace:RoomieSync.App.Controls">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,22,28,24">
        
        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="22,18">
          <Grid>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource S.AddExpense.DetailsTitle}" Style="{StaticResource CardTitle}" />
              <TextBlock Text="{DynamicResource S.AddExpense.DetailsSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding IsScanMode, Converter={StaticResource InverseBool}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource S.AddExpense.Manual}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource SegmentButton}"
                                             IsChecked="{Binding IsScanMode}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Drop Receipt Photo" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        
        <Border Style="{StaticResource Banner}" Margin="0,0,0,16"
                        Visibility="{Binding ReceiptError, Converter={StaticResource EmptyToCollapsed}}">
          <TextBlock Text="{Binding ReceiptError}" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="0.95*" />
          </Grid.ColumnDefinitions>

          
          <StackPanel Grid.Column="0">
            
            <Border Style="{StaticResource Card}" Margin="0,0,0,20"
                                Visibility="{Binding IsScanMode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <TextBlock Text="{DynamicResource S.AddExpense.UploadTitle}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                  <Border Style="{StaticResource Pill}" Background="{StaticResource PurpleLightBrush}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE734;" Style="{StaticResource Icon}" Foreground="{StaticResource PurpleBrush}" FontSize="10" Margin="0,0,5,0" />
                      <TextBlock Text="{DynamicResource S.AddExpense.PoweredByGemini}" FontFamily="{StaticResource AppFont}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PurpleBrush}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border AllowDrop="True" DragOver="OnReceiptDragOver" Drop="OnReceiptDrop" MouseLeftButtonUp="OnDropZoneClick"
                                        CornerRadius="12" BorderThickness="1.5" BorderBrush="#E5DDD5" Background="#FAF6F2" Padding="22,26" Cursor="Hand">
                  <StackPanel HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                      <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource BaseText}" FontWeight="SemiBold">
                                            <Run Text="{DynamicResource S.AddExpense.DropHere}" />
                                            <Run Text=" " />
                                            <Run Text="{DynamicResource S.AddExpense.Browse}" Foreground="{StaticResource PrimaryBrush}" />
                    </TextBlock>
                    <TextBlock Text="{DynamicResource S.AddExpense.DropHint}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{DynamicResource S.AddExpense.Recognizing}" Style="{StaticResource BaseText}" Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                   Visibility="{Binding IsParsing, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Margin="0,0,0,14" Visibility="{Binding IsScanMode, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="{DynamicResource S.AddExpense.ReviewTitle}" Style="{StaticResource CardTitle}" />
                  <TextBlock Text="{DynamicResource S.AddExpense.ReviewSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="{DynamicResource S.AddExpense.FieldTitle}" Style="{StaticResource Label}" />
                <TextBox Style="{StaticResource InputBox}" h:Input.Icon="&#xE8EC;"
                                         h:Input.Placeholder="{DynamicResource S.AddExpense.TitlePlaceholder}"
                                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                <UniformGrid Columns="2" Margin="-6,0,-6,14">
                  <StackPanel Margin="6,0">
                    <TextBlock Text="{DynamicResource S.AddExpense.FieldAmount}" Style="{StaticResource Label}" />
                    <TextBox Style="{StaticResource InputBox}" h:Input.Prefix="{Binding CurrencySymbol}"
                                                 h:Input.Placeholder="0.00"
                                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                  <StackPanel Margin="6,0">
                    <TextBlock Text="{DynamicResource S.AddExpense.FieldDate}" Style="{StaticResource Label}" />
                    <DatePicker Style="{StaticResource AppDatePicker}" SelectedDate="{Binding Date}" />
                  </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="-6,0">
                  <StackPanel Margin="6,0">
                    <TextBlock Text="{DynamicResource S.AddExpense.FieldCategory}" Style="{StaticResource Label}" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                  </StackPanel>
                  <StackPanel Margin="6,0">
                    <TextBlock Text="{DynamicResource S.AddExpense.FieldPaidBy}" Style="{StaticResource Label}" />
                    <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Members}" SelectedItem="{Binding PaidBy}" />
                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>

          
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{DynamicResource S.AddExpense.SplitTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                <Border Style="{StaticResource SegmentHost}" Margin="0,0,0,14">
                  <UniformGrid Columns="3">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource S.Split.Equally}"
                                                     IsChecked="{Binding SplitMethod, Converter={StaticResource Equals}, ConverterParameter=Equally}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource S.Split.ByPercentage}"
                                                     IsChecked="{Binding SplitMethod, Converter={StaticResource Equals}, ConverterParameter=ByPercentage}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{DynamicResource S.Split.ByExactAmount}"
                                                     IsChecked="{Binding SplitMethod, Converter={StaticResource Equals}, ConverterParameter=ByExactAmount}" />
                  </UniformGrid>
                </Border>

                <ItemsControl ItemsSource="{Binding Splits}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,7">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,10,0" VerticalAlignment="Center">
                          <c:Avatar Size="32" Initials="{Binding Member.Initials}" ColorHex="{Binding Member.AvatarColor}" Margin="0,0,10,0" />
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Member.FirstName}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Caption}" FontSize="10.5" />
                          </StackPanel>
                        </StackPanel>
                        <TextBox Grid.Column="2" Style="{StaticResource SmallInputBox}"
                                                         h:Input.Prefix="{Binding Prefix}"
                                                         IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                                                         Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Divider}" Margin="0,12" />
                <Grid>
                  <TextBlock Text="{Binding SelectedText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource S.AddExpense.TotalSplit}" Style="{StaticResource BaseText}" FontWeight="SemiBold" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding SplitTotalText}" Style="{StaticResource BaseText}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Padding="14,11" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding SplitHint}" Style="{StaticResource Caption}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Errors}" Margin="0,12,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Banner}" Margin="0,4,0,0">
                    <TextBlock Text="{Binding}" Style="{StaticResource BaseText}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    
    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
      <Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource S.AddExpense.FieldAmount}" Style="{StaticResource Caption}" />
          <TextBlock Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource CardTitle}" FontSize="18" FontWeight="Bold" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Common.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,12,0" />
          <Button Style="{StaticResource PrimaryButton}" Padding="20,10" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="White" FontSize="11" Margin="0,0,8,0" />
              <TextBlock Text="{DynamicResource S.AddExpense.Save}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>