<UserControl x:Class="RoomieSync.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoomieSync.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,24,28,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="1.15*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="20" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      
      <Button Command="{Binding OpenSettlementsCommand}" Cursor="Hand" Focusable="False">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <ContentPresenter />
          </ControlTemplate>
        </Button.Template>
        <Border CornerRadius="{StaticResource CardRadius}" Padding="24,22" Height="140" ClipToBounds="True" Effect="{StaticResource CardShadow}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource BalancePositiveBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsOwed}" Value="False">
                  <Setter Property="Background" Value="{StaticResource BalanceNegativeBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Ellipse Width="150" Height="150" Fill="#1AFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-60,0" />
            <Border Width="38" Height="38" CornerRadius="10" Background="#33FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top">
              <TextBlock Text="&#xE8C7;" Style="{StaticResource Icon}" Foreground="White" FontSize="15" />
            </Border>
            <StackPanel>
              <TextBlock Text="{DynamicResource S.Dashboard.MyBalance}" Foreground="#E6FFFFFF" FontSize="12.5" FontWeight="Medium" FontFamily="{StaticResource AppFont}" />
              <TextBlock Text="{Binding MyBalance, Converter={StaticResource Money}, ConverterParameter=signed}" Foreground="White"
                                       FontSize="32" FontWeight="Bold" FontFamily="{StaticResource AppFont}" Margin="0,10,0,4" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#E6FFFFFF" FontSize="11" Margin="0,0,6,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                      <Setter Property="Text" Value="&#xE74A;" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOwed}" Value="False">
                          <Setter Property="Text" Value="&#xE74B;" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding BalanceStatus}" Foreground="#E6FFFFFF" FontSize="12" FontFamily="{StaticResource AppFont}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Button>

      
      <Border Grid.Column="2" Style="{StaticResource Card}" Height="140">
        <Grid>
          
          <Button Command="{Binding OpenMonthlyReportsCommand}"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="{DynamicResource S.Nav.Reports}">
            <Border Width="38" Height="38" CornerRadius="10" Background="#FFF0E6">
              <TextBlock Text="&#xE7BF;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="15" />
            </Border>
          </Button>
          <StackPanel>
            <TextBlock Text="{DynamicResource S.Dashboard.TotalExpenses}" Style="{StaticResource Muted}" FontSize="12.5" />
            <TextBlock Text="{Binding TotalThisMonth, Converter={StaticResource Money}}" Style="{StaticResource BigNumber}" FontSize="32" Margin="0,10,0,4" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding HasLastMonth, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="11" Margin="0,0,6,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                    <Setter Property="Text" Value="&#xE74B;" />
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                        <Setter Property="Text" Value="&#xE74A;" />
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding ChangeText}" FontSize="12">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      
      <Border Grid.Row="2" Style="{StaticResource Card}">
        <DockPanel>
          <Grid DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource S.Dashboard.ByCategory}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{DynamicResource S.Dashboard.ThisMonth}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Categories}" Margin="0,18,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="8,3" ToolTip="{Binding Value, Converter={StaticResource Money}}">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,7,0" />
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11.5" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="0,16,0,0" Height="170">
            <c:DonutChart ItemsSource="{Binding Categories}" Width="170" Height="170" Thickness="0.4" />
            <TextBlock Text="{DynamicResource S.Dashboard.NoExpenses}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasExpenses, Converter={StaticResource InverseBoolToVis}}" />
          </Grid>
        </DockPanel>
      </Border>

      
      <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource S.Dashboard.Recent}" Style="{StaticResource CardTitle}" />
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Command="{Binding ViewAllExpensesCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource S.Dashboard.ViewAll}" FontSize="11.5" />
                <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="10" Margin="6,0,0,0" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding RecentExpenses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,9">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="10" Background="{Binding CategoryLightBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding CategoryBrush}" FontSize="15" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <c:Avatar Size="16" Initials="{Binding Payer.Initials}" ColorHex="{Binding Payer.AvatarColor}" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding PaidByText}" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource BaseText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding RelativeDate}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      
      <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource S.Dashboard.ActiveChores}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource GhostButton}" Padding="12,7" FontSize="12" Margin="0,0,8,0"
                                    Content="{DynamicResource S.Dashboard.OpenBoard}" Command="{Binding OpenChoresCommand}" />
              <Button Style="{StaticResource PrimaryButton}" Padding="14,7" FontSize="12" Command="{Binding AddChoreCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" FontSize="10" Margin="0,0,7,0" />
                  <TextBlock Text="{DynamicResource S.Dashboard.AddChore}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.2*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource S.Chores.TaskName}" Style="{StaticResource TableHeader}" />
            <TextBlock Grid.Column="1" Text="{DynamicResource S.Chores.AssignedTo}" Style="{StaticResource TableHeader}" />
            <TextBlock Grid.Column="2" Text="{DynamicResource S.Chores.Deadline}" Style="{StaticResource TableHeader}" />
            <TextBlock Grid.Column="3" Text="{DynamicResource S.Chores.Status}" Style="{StaticResource TableHeader}" />
          </Grid>
          <Border Style="{StaticResource Divider}" />
          <TextBlock Text="{DynamicResource S.Chores.NoActive}" Style="{StaticResource Muted}" Margin="0,16,0,4"
                               Visibility="{Binding ActiveChores.Count, Converter={StaticResource EmptyToVisible}}" />
          <ItemsControl ItemsSource="{Binding ActiveChores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:Avatar Size="26" Initials="{Binding Assignee.Initials}" ColorHex="{Binding Assignee.AvatarColor}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AssigneeName}" Style="{StaticResource BaseText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding DeadlineText}" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  
                  <Button Grid.Column="3" HorizontalAlignment="Left" Cursor="Hand" ToolTip="{Binding NextStatusHint}"
                                            Command="{Binding DataContext.AdvanceChoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Button.Template>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" Focusable="False" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
