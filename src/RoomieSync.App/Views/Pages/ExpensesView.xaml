<UserControl x:Class="RoomieSync.App.Views.Pages.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoomieSync.App.Controls"
             xmlns:h="clr-namespace:RoomieSync.App.Helpers">
    <UserControl.Resources>
        
        <Style x:Key="TableGrid" TargetType="Grid">
            <Setter Property="Margin" Value="22,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            
            <Grid Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource S.Expenses.Subtitle}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{DynamicResource S.Expenses.Total}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Total, Converter={StaticResource Money}}" Style="{StaticResource PageTitle}" FontWeight="Bold" />
                </StackPanel>
            </Grid>

            
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource InputBox}" Height="38" h:Input.Icon="&#xE721;" h:Input.Placeholder="{DynamicResource S.Expenses.Search}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox Style="{StaticResource FilterComboBox}" h:Input.Icon="&#xE787;" ItemsSource="{Binding DateFilters}"
                              SelectedItem="{Binding SelectedDateFilter}" Margin="0,0,10,0" ToolTip="{DynamicResource S.Expenses.FilterDate}" />
                    <ComboBox Style="{StaticResource FilterComboBox}" h:Input.Icon="&#xE77B;" ItemsSource="{Binding People}"
                              SelectedItem="{Binding SelectedPerson}" Margin="0,0,10,0" ToolTip="{DynamicResource S.Expenses.FilterPerson}" />
                    <ComboBox Style="{StaticResource FilterComboBox}" h:Input.Icon="&#xE71C;" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}" ToolTip="{DynamicResource S.Expenses.FilterCategory}" />
                </StackPanel>
            </Grid>

            
            <Border Style="{StaticResource Card}" Padding="0,6,0,0">
                <StackPanel>
                    <Grid Style="{StaticResource TableGrid}" Height="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource S.Expenses.ColDate}" Style="{StaticResource TableHeader}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource S.Expenses.ColDescription}" Style="{StaticResource TableHeader}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{DynamicResource S.Expenses.ColPaidBy}" Style="{StaticResource TableHeader}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{DynamicResource S.Expenses.ColTotal}" Style="{StaticResource TableHeader}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{DynamicResource S.Expenses.ColShare}" Style="{StaticResource TableHeader}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="{DynamicResource S.Expenses.ColActions}" Style="{StaticResource TableHeader}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />

                    <StackPanel Margin="0,40" HorizontalAlignment="Center" Visibility="{Binding Rows.Count, Converter={StaticResource EmptyToVisible}}">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{DynamicResource S.Expenses.Empty}" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid Style="{StaticResource TableGrid}" Height="54">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="8" Background="{Binding CategoryLightBrush}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding CategoryBrush}" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}" VerticalAlignment="Center" FontWeight="Medium" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <c:Avatar Size="26" Initials="{Binding Payer.Initials}" ColorHex="{Binding Payer.AvatarColor}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Payer.FirstName}" Style="{StaticResource BaseText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Amount, Converter={StaticResource Money}}" Style="{StaticResource BaseText}"
                                                   FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding YourShare, Converter={StaticResource Money}}" Style="{StaticResource Muted}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Background="Transparent" Width="30" Height="30"
                                                Content="&#xE712;" HorizontalAlignment="Center" ToolTip="{DynamicResource S.Expenses.Details}"
                                                Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#FFFCFA" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    
                    <Grid Margin="22,14">
                        <TextBlock Text="{Binding ShowingText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PagerButton}" Content="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                    Command="{Binding PreviousPageCommand}" Margin="0,0,6,0" />
                            <ItemsControl ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="PageBtn" Content="{Binding Number}" Margin="0,0,6,0" Style="{StaticResource PagerButton}"
                                                Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Number}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="PageBtn" Property="Style" Value="{StaticResource PagerButtonActive}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource PagerButton}" Content="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                    Command="{Binding NextPageCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
