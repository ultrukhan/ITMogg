<UserControl x:Class="RoomieSync.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoomieSync.App.Controls"
             xmlns:h="clr-namespace:RoomieSync.App.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28" MaxWidth="760" HorizontalAlignment="Left" Width="760">
            
            <Border CornerRadius="10" Padding="14,10" Margin="0,0,0,18" Background="{StaticResource InfoLightBrush}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource InfoBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource S.Settings.AdminOnly}" Style="{StaticResource BaseText}" Foreground="{StaticResource InfoBrush}" FontSize="12" />
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Settings.HouseholdInfo}" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource S.Setup.HouseholdName}" Style="{StaticResource Label}" />
                    <TextBox Style="{StaticResource SoftInputBox}" Width="320" HorizontalAlignment="Left"
                             Text="{Binding HouseholdName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsAdmin}" />
                    <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,8" FontSize="12"
                            Content="{DynamicResource S.Settings.SaveChanges}" Command="{Binding SaveHouseholdCommand}" IsEnabled="{Binding IsAdmin}" />
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource S.Settings.Members}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MemberLimitText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:Avatar Size="40" Initials="{Binding Member.Initials}" ColorHex="{Binding Member.AvatarColor}" />
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Member.DisplayName}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource S.Settings.You}" Style="{StaticResource Caption}" Margin="6,0,0,0"
                                                       Visibility="{Binding IsMe, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource S.Role.Admin}" Style="{StaticResource Caption}" FontSize="10.5" Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding Member.IsAdmin, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Email}" Style="{StaticResource Caption}" FontSize="10.5"
                                                   Visibility="{Binding HasLogin, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{DynamicResource S.Settings.NoLogin}" Style="{StaticResource Caption}" FontSize="10.5" FontStyle="Italic"
                                                   Visibility="{Binding HasLogin, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S.Settings.EditName}" Margin="0,0,6,0"
                                                    IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Command="{Binding DataContext.EditMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource DangerOutlineButton}" Content="{DynamicResource S.Settings.DeleteProfile}"
                                                    Command="{Binding DataContext.DeleteMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.IsEnabled>
                                                    <MultiBinding Converter="{StaticResource AllTrue}">
                                                        <Binding Path="CanDelete" />
                                                        <Binding Path="DataContext.IsAdmin" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                    </MultiBinding>
                                                </Button.IsEnabled>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource S.Settings.CannotDelete}" Style="{StaticResource Caption}" FontSize="10" FontStyle="Italic"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="{Binding ShowDebtNote, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" Margin="0,12,0,16" />
                    <TextBlock Text="{DynamicResource S.Settings.InviteMember}" Style="{StaticResource Label}" />
                    <Grid IsEnabled="{Binding CanAddMore}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SoftInputBox}" h:Input.Placeholder="{DynamicResource S.Settings.MemberPlaceholder}"
                                 Text="{Binding NewMemberName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding AddMemberCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Foreground="White" FontSize="10" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource S.Settings.AddMember}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{DynamicResource S.Settings.AddMemberHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
