<UserControl x:Class="RoomieSync.App.Views.Pages.ChoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoomieSync.App.Controls"
             xmlns:m="clr-namespace:RoomieSync.Core.Models;assembly=RoomieSync.Core">
    <UserControl.Resources>
        
        <DataTemplate x:Key="ChoreCard">
            <Border Style="{StaticResource InnerCard}" Margin="0,0,0,12" Padding="16,14" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BaseText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        
                        <Button Grid.Column="1" Width="24" Height="24" Cursor="Hand" ToolTip="{Binding NextStatusHint}" Margin="6,0,0,0"
                                Command="{Binding DataContext.AdvanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="12" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="StatusIcon" Text="{Binding StatusGlyph}" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Background="Transparent" Width="24" Height="24" FontSize="11"
                                Content="&#xE712;" Margin="2,0,-4,0" ToolTip="{DynamicResource S.Common.Edit}"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <Border CornerRadius="9" Padding="8,3" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,6,4"
                                Visibility="{Binding HasRotation, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="9" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding RotationText}" Foreground="{StaticResource PrimaryBrush}" FontSize="10.5" FontWeight="Medium" FontFamily="{StaticResource AppFont}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="DeadlinePill" CornerRadius="9" Padding="8,3" Background="{StaticResource NeutralPillBrush}" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DeadlineIcon" Text="&#xE787;" Style="{StaticResource Icon}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" Margin="0,0,5,0" />
                                <TextBlock x:Name="DeadlineText" Text="{Binding DeadlineText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5"
                                           FontWeight="Medium" FontFamily="{StaticResource AppFont}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <Grid Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Avatar Size="26" Initials="{Binding Assignee.Initials}" ColorHex="{Binding Assignee.AvatarColor}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding AssigneeName}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource SoftButton}" HorizontalAlignment="Right"
                                Command="{Binding DataContext.ChangeAssigneeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource S.Chores.ChangeAssignee}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ChoreStatus.InProgress}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ChoreStatus.Done}">
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter TargetName="DeadlinePill" Property="Background" Value="{StaticResource DangerLightBrush}" />
                    <Setter TargetName="DeadlineText" Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="DeadlineIcon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Column" TargetType="Border">
            <Setter Property="Background" Value="#F6F1EC" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <UniformGrid Columns="3" Margin="20,22,20,28" VerticalAlignment="Top">
            
            <Border Style="{StaticResource Column}">
                <StackPanel>
                    <Grid Margin="4,0,4,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#9AA1B2" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Status.ToDo}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="{StaticResource InfoLightBrush}" Padding="8,1">
                            <TextBlock Text="{Binding ToDo.Count}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" />
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ToDo}" ItemTemplate="{StaticResource ChoreCard}" />
                    <TextBlock Text="{DynamicResource S.Chores.EmptyColumn}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8"
                               Visibility="{Binding ToDo.Count, Converter={StaticResource EmptyToVisible}}" />
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource Column}">
                <StackPanel>
                    <Grid Margin="4,0,4,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Status.InProgress}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="{StaticResource WarningLightBrush}" Padding="8,1">
                            <TextBlock Text="{Binding InProgress.Count}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="#B7791F" />
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding InProgress}" ItemTemplate="{StaticResource ChoreCard}" />
                    <TextBlock Text="{DynamicResource S.Chores.EmptyColumn}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8"
                               Visibility="{Binding InProgress.Count, Converter={StaticResource EmptyToVisible}}" />
                </StackPanel>
            </Border>
            
            <Border Style="{StaticResource Column}">
                <StackPanel>
                    <Grid Margin="4,0,4,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Status.Done}" Style="{StaticResource BaseText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Background="{StaticResource SuccessLightBrush}" Padding="8,1">
                            <TextBlock Text="{Binding Done.Count}" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Done}" ItemTemplate="{StaticResource ChoreCard}" />
                    <TextBlock Text="{DynamicResource S.Chores.EmptyColumn}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8"
                               Visibility="{Binding Done.Count, Converter={StaticResource EmptyToVisible}}" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </ScrollViewer>
</UserControl>
