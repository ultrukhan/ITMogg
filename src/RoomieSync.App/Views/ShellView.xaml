<UserControl x:Class="RoomieSync.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RoomieSync.App.Controls"
             xmlns:h="clr-namespace:RoomieSync.App.Helpers"
             xmlns:vm="clr-namespace:RoomieSync.App.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,30">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryBrush}" Effect="{StaticResource ButtonShadow}">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" Foreground="White" FontSize="17" />
                    </Border>
                    <TextBlock Text="{Binding HouseholdName}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="13.5"
                               Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="140" />
                </StackPanel>

                
                <Border DockPanel.Dock="Bottom" CornerRadius="12" Background="{StaticResource PrimaryLightBrush}" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="0,0,7,0" />
                            <TextBlock Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="12" Foreground="#B5532A">
                                <Run Text="{Binding MemberCount, Mode=OneWay}" /> <Run Text="{DynamicResource S.Shell.Members}" />
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding SinceText}" Style="{StaticResource Caption}" FontSize="10.5" Foreground="#C77850"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xF0E2;" Content="{DynamicResource S.Nav.Dashboard}"
                                 GroupName="Nav" IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Dashboard}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Dashboard}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8C7;" Content="{DynamicResource S.Nav.Expenses}"
                                 GroupName="Nav" IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Expenses}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Expenses}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8AB;" Content="{DynamicResource S.Nav.Settlements}"
                                 GroupName="Nav" IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Settlements}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Settlements}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D5;" Content="{DynamicResource S.Nav.Chores}"
                                 GroupName="Nav" IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Chores}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Chores}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE9D2;" Content="{DynamicResource S.Nav.Reports}"
                                 GroupName="Nav" IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Reports}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Reports}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{DynamicResource S.Nav.Settings}"
                                 GroupName="Nav" IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavSection.Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        
        <DockPanel Grid.Column="1">
            
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Navigation.CurrentPage.CaptionKey, Converter={StaticResource Loc}}" Style="{StaticResource Caption}" />
                        <TextBlock Style="{StaticResource PageTitle}">
                            <TextBlock.Text>
                                <Binding Path="Navigation.CurrentPage.TitleKey" Converter="{StaticResource Loc}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    
                    <ContentControl Grid.Column="1" Content="{Binding Navigation.CurrentPage}" VerticalAlignment="Center" Focusable="False" Margin="0,0,16,0">
                        <ContentControl.ContentTemplateSelector>
                            <h:KeyedTemplateSelector Prefix="HeaderActions." />
                        </ContentControl.ContentTemplateSelector>
                    </ContentControl>

                    
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ToggleButton x:Name="BellButton" IsChecked="{Binding IsNotificationsOpen}" Cursor="Hand" ToolTip="{DynamicResource S.Notifications.Title}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Width="38" Height="38">
                                        <Border x:Name="Bd" CornerRadius="19" Background="{StaticResource SurfaceAltBrush}" />
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource Icon}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" Stroke="White" StrokeThickness="1.5"
                                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,9,0"
                                                 Visibility="{Binding UnreadCount, Converter={StaticResource EmptyToCollapsed}}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsNotificationsOpen}" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
                               HorizontalOffset="-300" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="360" Background="{StaticResource SurfaceBrush}" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Margin="10" Effect="{StaticResource PopupShadow}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="18,14,14,8">
                                        <TextBlock Text="{DynamicResource S.Notifications.Title}" Style="{StaticResource CardTitle}" FontSize="14" />
                                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" FontSize="11"
                                                Content="{DynamicResource S.Notifications.MarkAllRead}" Command="{Binding MarkAllReadCommand}" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource S.Notifications.Empty}" Style="{StaticResource Muted}" Margin="18,10,18,18"
                                               Visibility="{Binding Notifications.Count, Converter={StaticResource EmptyToVisible}}" />
                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Notifications}" Margin="6,0,6,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Row" CornerRadius="10" Padding="12,9" Margin="0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource SurfaceAltBrush}" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{Binding AccentBrush}" FontSize="12" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,6,0">
                                                                <TextBlock Text="{Binding Message}" Style="{StaticResource BaseText}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Top" Margin="0,5,0,0"
                                                                     Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#FFFBF8" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <ToggleButton x:Name="UserButton" IsChecked="{Binding IsUserMenuOpen}" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="12" Padding="6,4" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Avatar Size="38" Initials="{Binding CurrentMember.Initials}" ColorHex="{Binding CurrentMember.AvatarColor}" />
                                            <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentMember.DisplayName}" Style="{StaticResource BaseText}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding RoleText}" Style="{StaticResource Caption}" FontSize="10.5" />
                                            </StackPanel>
                                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsUserMenuOpen}" PlacementTarget="{Binding ElementName=UserButton}" Placement="Bottom"
                               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="210" Background="{StaticResource SurfaceBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Padding="6" Margin="10" Effect="{StaticResource PopupShadow}">
                                <StackPanel>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                            <TextBlock Text="{DynamicResource S.Nav.Settings}" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding SignOutCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xF3B1;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0" />
                                            <TextBlock Text="{DynamicResource S.Shell.LogOut}" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            
            <ContentControl Content="{Binding Navigation.CurrentPage}" Focusable="False" />
        </DockPanel>
    </Grid>
</UserControl>
